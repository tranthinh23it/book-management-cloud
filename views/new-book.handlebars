<div style="max-width:560px; margin:0 auto;">
  <h2 style="font-size:1.5rem; font-weight:700; margin-bottom:1.5rem;">Thêm sách mới</h2>

  {{#if error}}
  <div class="alert-error">⚠️ {{error}}</div>
  {{/if}}

  <form action="/books" method="POST"
    style="background:#1e293b; border:1px solid #334155; border-radius:12px; padding:2rem; display:flex; flex-direction:column; gap:1.2rem;">

    <div>
      <label style="display:block; font-size:0.85rem; color:#94a3b8; margin-bottom:0.4rem;">Mã sách *</label>
      <input type="text" name="productCode" placeholder="VD: 263-001" required
        style="width:100%; padding:0.6rem 0.9rem; background:#0f172a; border:1px solid #334155; border-radius:8px; color:#e2e8f0; font-size:0.95rem; outline:none; transition:border-color 0.2s;"
        onfocus="this.style.borderColor='#38bdf8'" onblur="this.style.borderColor='#334155'" />
    </div>

    <div>
      <label style="display:block; font-size:0.85rem; color:#94a3b8; margin-bottom:0.4rem;">Tên sách *</label>
      <input type="text" name="title" placeholder="Nhập tên sách" required
        style="width:100%; padding:0.6rem 0.9rem; background:#0f172a; border:1px solid #334155; border-radius:8px; color:#e2e8f0; font-size:0.95rem; outline:none; transition:border-color 0.2s;"
        onfocus="this.style.borderColor='#38bdf8'" onblur="this.style.borderColor='#334155'" />
    </div>

    <div>
      <label style="display:block; font-size:0.85rem; color:#94a3b8; margin-bottom:0.4rem;">Tác giả *</label>
      <input type="text" name="author" placeholder="Nhập tên tác giả" required
        style="width:100%; padding:0.6rem 0.9rem; background:#0f172a; border:1px solid #334155; border-radius:8px; color:#e2e8f0; font-size:0.95rem; outline:none; transition:border-color 0.2s;"
        onfocus="this.style.borderColor='#38bdf8'" onblur="this.style.borderColor='#334155'" />
    </div>

    <div>
      <label style="display:block; font-size:0.85rem; color:#94a3b8; margin-bottom:0.4rem;">Giá gốc (VND) *</label>
      <input type="number" name="price" placeholder="VD: 150000" min="0" required
        style="width:100%; padding:0.6rem 0.9rem; background:#0f172a; border:1px solid #334155; border-radius:8px; color:#e2e8f0; font-size:0.95rem; outline:none; transition:border-color 0.2s;"
        onfocus="this.style.borderColor='#38bdf8'" onblur="this.style.borderColor='#334155'" />
    </div>

    <div style="display:flex; gap:1rem; margin-top:0.5rem;">
      <button type="submit" class="btn btn-primary" style="flex:1; padding:0.7rem;">💾 Lưu sách</button>
      <a href="/books" class="btn" style="flex:1; padding:0.7rem; text-align:center; background:#334155; color:#e2e8f0;">Hủy</a>
    </div>
  </form>
</div>
